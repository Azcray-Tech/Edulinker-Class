<?php
/**
 * Script para procesar la creación de un nuevo artículo. (backup)
 */

include_once(__DIR__ . "/../../lib/common.php");
include_once(__DIR__ . "/../../lib/articles.php");
include_once(__DIR__ . "/../../lib/helpers.php");
include_once(__DIR__ . "/../../lib/user.php");

if (!(verificarPermiso(1) || verificarPermiso(2))) {
    header("Location:" . BASE_URL . "index.php?error=permiso_denegado");
    exit();
}

if ($_SERVER["REQUEST_METHOD"] == "POST") {
    $title = trim(filter_input(INPUT_POST, 'title', FILTER_SANITIZE_STRING));
    $article_content = trim($_POST['article']);
    $category = trim(filter_input(INPUT_POST, 'category', FILTER_SANITIZE_STRING));

    $user_id = obtenerUsuarioSesion()['id'] ?? null;

    if (empty($title)) {
        $error = "El título del artículo es obligatorio.";
    } elseif (empty($article_content)) {
        $error = "El contenido del artículo es obligatorio.";
    } elseif (empty($category)) {
        $error = "Debe seleccionar una categoría.";
    } elseif (empty($user_id)) {
        $error = "No se pudo identificar al usuario.";
    }

    $image_path = null;
    if (isset($_FILES['image']) && $_FILES['image']['error'] === UPLOAD_ERR_OK) {
        $allowed_types = ['image/jpeg', 'image/jpg', 'image/png'];
        $file_type = mime_content_type($_FILES['image']['tmp_name']);

        if (in_array($file_type, $allowed_types)) {
            $upload_dir = UPLOADS_URL . "articles/cover/";
            if (!is_dir($upload_dir)) {
                mkdir($upload_dir, 0755, true);
            }
            $file_name = uniqid('article_') . "." . pathinfo($_FILES['image']['name'], PATHINFO_EXTENSION);
            $destination_path = $upload_dir . $file_name;

            if (move_uploaded_file($_FILES['image']['tmp_name'], $destination_path)) {
                $image_path = 'uploads/articles/' . $file_name;
            } else {
                $error = "Error al subir la imagen de portada.";
            }
        } else {
            $error = "Formato de imagen no válido. Solo se permiten JPG, JPEG y PNG.";
        }
    } elseif (isset($_FILES['image']) && $_FILES['image']['error'] !== UPLOAD_ERR_NO_FILE) {
        $error = "Error al cargar la imagen de portada.";
    }

    if (!isset($error)) {
        global $conexion;

        $stmt = $conexion->prepare("INSERT INTO articles (title, article, image, category, user, date) VALUES (?, ?, ?, ?, ?, NOW())");
        $stmt->bind_param("ssssi", $title, $article_content, $image_path, $category, $user_id);

        if ($stmt->execute()) {
            header("Location:" . BASE_URL . "index.php?success=articulo_creado");
            exit();
        } else {
            $error = "Error al guardar el artículo en la base de datos: " . $stmt->error;
        }

        $stmt->close();
    }

    if (isset($error)) {
        header("Location:" . VIEWS_URL . "articles/create_article.php?error=" . urlencode($error));
        exit();
    }
} else {
    header("Location:" . BASE_URL . "index.php?error=metodo_no_permitido");
    exit();
}
?>
