<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /Edulinker-Class/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php/$1 [L]

    ErrorDocument 404 /Edulinker-Class/views/errors/404.php
    ErrorDocument 500 /Edulinker-Class/views/errors/500.php
</IfModule>
